# Podly AI — Backend Environment Configuration
# Copy this to backend/.env and customize

# Model sizes: tiny | base | small | medium | large
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
TRANSCRIPTION_ENGINE=faster-whisper
FAST_PROCESSING=true

# Summarizer (HuggingFace model name)
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6

# Embedding model for BERTopic
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Max upload size in MB
MAX_UPLOAD_SIZE_MB=500

# Concurrent AI processing jobs. Keep at 1 for CPU-only setups; increase for
# machines with enough memory or a dedicated GPU.
PROCESSING_WORKERS=1

# Minimum chapter duration in seconds
MIN_CHAPTER_DURATION_SECONDS=30

# CORS origins (comma-separated)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
